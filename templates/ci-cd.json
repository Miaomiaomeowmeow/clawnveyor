{
  "id": "ci-cd",
  "label": "代码 → 上线（CI/CD）",
  "label_en": "Code → live (CI/CD)",
  "blurb": "仓库推代码 → 三条测试线并排跑（挂了退回）→ 制品库 → 按环境攒版本 → 部署 → 上线到各个服务",
  "blurb_en": "Pushes come in → three test lanes (failures go back) → artifact store → batch releases per environment → deploy → live services",
  "sample": true,
  "title": "克鸟发布站",
  "title_en": "Clawnveyor CI",
  "unit": "个",
  "unit_en": "builds",
  "stations": [
    {
      "id": "dock",
      "on": true,
      "name": "收代码",
      "name_en": "Code in",
      "en": "CODE IN",
      "desc": "每个仓库一辆车，推送和合并请求开进来",
      "desc_en": "One truck per repo; pushes and pull requests drive in"
    },
    {
      "id": "sort",
      "on": true,
      "name": "测试",
      "name_en": "Test",
      "en": "TESTING",
      "desc": "三台测试机并排跑，没过的退回给提交的人",
      "desc_en": "Three runners test side by side; failures go back to the author"
    },
    {
      "id": "store",
      "on": true,
      "name": "制品库",
      "name_en": "Artifacts",
      "en": "ARTIFACTS",
      "desc": "通过的打包成制品，放进制品库",
      "desc_en": "Passing builds are packed and stored as artifacts"
    },
    {
      "id": "shop",
      "on": true,
      "name": "攒版本",
      "name_en": "Release",
      "en": "RELEASE TRAIN",
      "desc": "按环境攒一车，够数就发版",
      "desc_en": "One cart per environment; a full cart becomes a release"
    },
    {
      "id": "make",
      "on": true,
      "name": "部署",
      "name_en": "Deploy",
      "en": "DEPLOY",
      "desc": "满车开过来：灰度、上架，部署好的版本放上货架",
      "desc_en": "Full carts roll out; deployed versions go on the shelf"
    },
    {
      "id": "use",
      "on": true,
      "name": "上线",
      "name_en": "Live",
      "en": "LIVE",
      "desc": "新版本送到每个服务手里",
      "desc_en": "New versions reach every service"
    }
  ],
